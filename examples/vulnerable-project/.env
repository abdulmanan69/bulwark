# Deliberately unsafe example, used to demonstrate Bulwark's detections.
#
# Every credential here is fabricated AND deliberately avoids any vendor token
# format, so that pushing this repository does not trip GitHub, GitLab or
# Bitbucket push protection. Bulwark still detects both lines: one by shape
# (a database URL carrying an inline password), one by entropy against a
# secret-named key.
DATABASE_URL=postgres://app:sup3rS3cretPw@db.internal:5432/main
SESSION_SECRET=9fK2mQ8xZ1pR7vL4nT6wY3bH5jC0dG
DEBUG=false
